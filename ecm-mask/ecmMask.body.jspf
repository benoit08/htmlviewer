<%@ page pageEncoding="UTF-8" %><%-- 정적 include 조각은 파일마다 인코딩을 따로 정함 (없으면 ISO-8859-1 로 읽혀 한글이 깨짐) --%>
<!-- ECM 문서 마스킹 화면 본문. ecmMask.jsp 가 정적 include, preview.html 은 첫 줄(지시문)을 떼고 사용. 이 아래에는 JSP/EL 구문을 넣지 말 것 -->
<div class="emk" id="ecmMask">
<div class="emk-wrap">

  <!-- ===== 좌측: ECM 업로드 리스트 ===== -->
  <section class="emk-pane emk-left">
    <h3>ECM 업로드 리스트</h3>
    <div class="emk-body">
      <div class="emk-filters">
        <div><label>처리일자</label><input class="form-control form-control-sm" data-ref="fProcDate" maxlength="8" placeholder="YYYYMMDD"></div>
        <div><label>처리일련번호</label><input class="form-control form-control-sm" data-ref="fProcSeq"></div>
        <div><label>ECM처리업무구분</label>
          <select class="form-control form-control-sm custom-select form-select" data-ref="fBizCd"><option value="">전체</option><option>SR01</option><option>SR02</option></select></div>
        <div><label>파일등록일련번호</label><input class="form-control form-control-sm" data-ref="fFileSeq"></div>
        <div><label>삭제여부</label>
          <select class="form-control form-control-sm custom-select form-select" data-ref="fDelYn"><option value="">전체</option><option selected>N</option><option>Y</option></select></div>
        <div><label>마스킹상태</label>
          <select class="form-control form-control-sm custom-select form-select" data-ref="fMaskYn"><option value="">전체</option><option value="N">미처리</option><option value="Y">마스킹완료</option></select></div>
      </div>
      <div class="emk-row">
        <button class="btn btn-primary btn-sm" data-ref="btnSearch">조회</button>
        <button class="btn btn-secondary btn-sm" data-ref="btnInit">초기화</button>
        <span class="emk-sp"></span>
        <span class="emk-mut">Show</span>
        <select class="form-control form-control-sm custom-select form-select" data-ref="pageSize" style="width:64px"><option>10</option><option>20</option><option>50</option></select>
        <span class="emk-mut">entries</span>
      </div>
      <div class="emk-row emk-sum" data-ref="sum"></div>
      <div class="emk-tbl">
        <table class="table table-hover table-bordered">
          <thead><tr>
            <th>마스킹<br>상태</th><th>처리일자</th><th>처리일시</th><th>처리<br>일련번호</th><th>ECM처리<br>업무구분</th>
            <th>파일등록<br>일련번호</th><th>파일명</th><th>고객<br>엔티티ID</th><th>삭제<br>여부</th>
          </tr></thead>
          <tbody data-ref="tbody"></tbody>
        </table>
      </div>
      <div class="emk-row">
        <span class="emk-mut" data-ref="pgInfo"></span><span class="emk-sp"></span><div class="emk-pg" data-ref="pg"></div>
      </div>
    </div>
  </section>

  <!-- ===== 우측: 뷰어 / 마스킹 ===== -->
  <section class="emk-pane emk-right">
    <h3>다중 영역 이미지 마스킹 <span class="emk-mut" data-ref="curName" style="font-weight:400;font-size:12px"></span></h3>
    <div class="emk-body">
      <div class="emk-row">
        <label class="emk-mut">마스크</label>
        <select class="form-control form-control-sm custom-select form-select" data-ref="maskType" style="width:150px">
          <option value="black">검은색 완전 가림</option>
          <option value="white">흰색 완전 가림</option>
          <option value="mosaic">모자이크</option>
        </select>
        <button class="btn btn-primary btn-sm" data-ref="btnApply" disabled title="단축키 M / Enter">선택 영역 마스킹 (M)</button>
        <button class="btn btn-secondary btn-sm" data-ref="btnDel" disabled title="단축키 Delete">선택 마스크 삭제</button>
        <button class="btn btn-secondary btn-sm" data-ref="btnUndo" disabled title="단축키 Ctrl+Z">마지막 마스킹 취소</button>
        <button class="btn btn-outline-danger btn-sm" data-ref="btnReset" disabled>전체 초기화</button>
      </div>
      <div class="emk-row">
        <button class="btn btn-primary btn-sm" data-ref="btnSave" disabled>ECM 저장</button>
        <button class="btn btn-secondary btn-sm" data-ref="btnPng" disabled>PNG 저장</button>
        <span class="emk-sp"></span>
        <button class="btn btn-secondary btn-sm" data-ref="btnPrev" disabled>&lt;</button><span data-ref="pageNo" class="emk-mut">0 / 0</span><button class="btn btn-secondary btn-sm" data-ref="btnNext" disabled>&gt;</button>
        <button class="btn btn-secondary btn-sm" data-ref="btnZoomOut" disabled>-</button><span data-ref="zoomLbl" class="emk-mut" style="min-width:46px;text-align:center">맞춤</span><button class="btn btn-secondary btn-sm" data-ref="btnZoomIn" disabled>+</button>
        <button class="btn btn-secondary btn-sm" data-ref="btnFit" disabled>맞춤</button>
      </div>
      <div class="emk-info" data-ref="msg">좌측 리스트에서 문서를 선택하세요.</div>
      <div class="emk-mut emk-help">드래그: 영역 선택 · <b>M</b>/Enter: 마스킹 · 마스크 클릭 후 드래그: 이동 · 모서리 드래그: 크기 조절 · 방향키: 미세 이동(Shift 10px) · Delete: 삭제 · Ctrl+Z: 취소 · Esc: 선택 해제</div>
      <div class="emk-vwrap" data-ref="vwrap">
        <div class="emk-empty" data-ref="empty">선택된 문서가 없습니다.</div>
        <canvas data-ref="cv" class="emk-cv" hidden></canvas>
        <iframe data-ref="pdfFrame" class="emk-pdf" title="PDF 미리보기"></iframe>
      </div>
    </div>
  </section>
</div>

<!-- 최종 확인 모달 -->
<div class="emk-modal" data-ref="modal">
  <div class="emk-dlg">
    <h4>마스킹 저장 최종 확인</h4>
    <div class="emk-mb">
      <div data-ref="cfInfo"></div>
      <div class="emk-warnbox">저장하면 ECM 문서가 마스킹본으로 처리되며 되돌릴 수 없습니다. 아래 결과를 반드시 확인하세요.</div>
      <div data-ref="cfPreview"></div>
      <label style="display:flex;gap:6px;align-items:center;margin-top:10px">
        <input type="checkbox" data-ref="cfChk" style="width:auto;height:auto"> 마스킹 결과를 확인하였으며 ECM에 저장합니다.
      </label>
    </div>
    <div class="emk-mf">
      <button class="btn btn-secondary btn-sm" data-ref="cfCancel">취소</button>
      <button class="btn btn-primary btn-sm" data-ref="cfOk" disabled>ECM 저장</button>
    </div>
  </div>
</div>
<div data-ref="toast" class="emk-toast"></div>
</div>
